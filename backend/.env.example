# App
NODE_ENV=development
PORT=3001
PUBLIC_WEBHOOK_BASE_URL=https://example.com
APP_BASE_URL=http://localhost:3001
COMPANY_ID=sabero

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Redis / Queue
REDIS_URL=redis://localhost:6379

# Meta WhatsApp Cloud API
META_GRAPH_API_VERSION=v25.0
META_APP_ID=1086951707051587
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=1200

# Google Calendar
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/integrations/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=
OAUTH_TOKEN_ENCRYPTION_KEY=
GOOGLE_PICKER_API_KEY=
GOOGLE_APP_ID=
DRIVE_SYNC_ENABLED=true
DRIVE_SYNC_INTERVAL_MS=900000
DRIVE_SYNC_BATCH_SIZE=10

# RAG / embeddings
EMBEDDINGS_PROVIDER=local-hash
EMBEDDINGS_MODEL=local-hash-v1
EMBEDDINGS_DIMENSIONS=1536

# Commercial controls
HUMAN_ESCALATION_EMAIL=
HUMAN_ESCALATION_WHATSAPP=
DEFAULT_TIMEZONE=America/Lima
FOLLOWUP_ENABLED=true
MAX_FOLLOWUPS_PER_LEAD=3

# Security
WEBHOOK_SIGNATURE_REQUIRED=true
OUTBOUND_WEBHOOK_SECRET=
OUTBOUND_WEBHOOK_URL=
SERVICE_API_KEY=
AUTH_SECRET=
AUTH_TOKEN_TTL_SECONDS=43200
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_COMPANY_ID=sabero

