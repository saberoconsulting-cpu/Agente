generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Company {
  id String @id
  name String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("companies")
}

model Lead {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id")
  whatsappNumber String @map("whatsapp_number")
  name String?
  status String @default("new")
  qualification Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  @@unique([companyId, whatsappNumber])
  @@map("leads")
}

model Conversation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id")
  leadId String? @map("lead_id") @db.Uuid
  channel String
  externalId String @map("external_id")
  state Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  @@unique([companyId, channel, externalId])
  @@map("conversations")
}

model InboundWebhookEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider String
  payload Json
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("inbound_webhook_events")
}

model Message {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id")
  conversationId String @map("conversation_id") @db.Uuid
  providerMessageId String? @unique @map("provider_message_id")
  direction String
  messageType String @map("message_type")
  textBody String? @map("text_body")
  rawPayload Json? @map("raw_payload")
  inboundEventId String? @map("inbound_event_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("messages")
}

model OutboundMessage {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id")
  recipient String
  textBody String @map("text_body")
  providerMessageId String? @map("provider_message_id")
  rawResponse Json? @map("raw_response")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("outbound_messages")
}

model GoogleOauthConnection {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @unique @map("company_id")
  providerAccountEmail String? @map("provider_account_email")
  scopes String[] @default([])
  encryptedTokens String @map("encrypted_tokens")
  connectedAt DateTime @default(now()) @map("connected_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  @@map("google_oauth_connections")
}

model WhatsappConnection {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id")
  metaAppId String? @map("meta_app_id")
  wabaId String @map("waba_id")
  phoneNumberId String @map("phone_number_id")
  displayPhoneNumber String? @map("display_phone_number")
  verifiedName String? @map("verified_name")
  encryptedAccessToken String @map("encrypted_access_token")
  scopes String[] @default([])
  tokenType String? @map("token_type")
  tokenExpiresAt DateTime? @map("token_expires_at") @db.Timestamptz(6)
  status String @default("pending")
  connectedAt DateTime? @map("connected_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  disconnectReason String? @map("disconnect_reason")
  lastWebhookAt DateTime? @map("last_webhook_at") @db.Timestamptz(6)
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(6)
  metadata Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  @@unique([companyId, phoneNumberId])
  @@map("whatsapp_connections")
}

model GoogleDriveFile {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id")
  googleFileId String @map("google_file_id")
  name String
  mimeType String @map("mime_type")
  webViewLink String? @map("web_view_link")
  version String?
  modifiedTime DateTime? @map("modified_time") @db.Timestamptz(6)
  trashed Boolean @default(false)
  syncStatus String @default("pending") @map("sync_status")
  lastSyncedAt DateTime? @map("last_synced_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  @@unique([companyId, googleFileId])
  @@map("google_drive_files")
}

model KnowledgeDocument {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id")
  sourceType String @map("source_type")
  sourceId String @map("source_id")
  title String
  mimeType String? @map("mime_type")
  sourceVersion String? @map("source_version")
  sourceModifiedAt DateTime? @map("source_modified_at") @db.Timestamptz(6)
  status String @default("indexed")
  metadata Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  @@unique([companyId, sourceType, sourceId])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id")
  documentId String @map("document_id") @db.Uuid
  chunkIndex Int @map("chunk_index")
  content String
  tokenCount Int? @map("token_count")
  metadata Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([documentId, chunkIndex])
  @@map("knowledge_chunks")
}

model KnowledgeEmbedding {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id")
  chunkId String @map("chunk_id") @db.Uuid
  provider String
  model String
  embedding Unsupported("vector(1536)")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([chunkId, provider, model])
  @@map("knowledge_embeddings")
}

model KnowledgeReference {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id")
  conversationId String? @map("conversation_id") @db.Uuid
  messageId String? @map("message_id") @db.Uuid
  documentId String? @map("document_id") @db.Uuid
  chunkId String? @map("chunk_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("knowledge_references")
}

model SyncJob {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id")
  sourceType String @map("source_type")
  sourceId String? @map("source_id")
  status String @default("pending")
  errorMessage String? @map("error_message")
  startedAt DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("sync_jobs")
}

model CompanyAgentSetting {
  companyId String @id @map("company_id")
  agentName String @default("Asistente virtual") @map("agent_name")
  tone String @default("consultivo, claro y orientado a conversion")
  language String @default("es")
  llmProvider String @default("deepseek") @map("llm_provider")
  llmModel String @default("deepseek-chat") @map("llm_model")
  systemRules String @default("") @map("system_rules")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  @@map("company_agent_settings")
}

model CompanyService {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id")
  name String
  description String
  active Boolean @default(true)
  metadata Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  @@map("company_services")
}

model NegotiationPolicy {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id")
  policyKey String @map("policy_key")
  policyText String @map("policy_text")
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  @@unique([companyId, policyKey])
  @@map("negotiation_policies")
}

model Meeting {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id")
  leadId String? @map("lead_id") @db.Uuid
  conversationId String? @map("conversation_id") @db.Uuid
  calendarProvider String @default("google") @map("calendar_provider")
  calendarId String @map("calendar_id")
  providerEventId String? @map("provider_event_id")
  title String
  description String?
  attendeeName String? @map("attendee_name")
  attendeeEmail String? @map("attendee_email")
  attendeePhone String? @map("attendee_phone")
  startTime DateTime @map("start_time") @db.Timestamptz(6)
  endTime DateTime @map("end_time") @db.Timestamptz(6)
  timezone String @default("America/Lima")
  status String @default("booked")
  idempotencyKey String? @map("idempotency_key")
  rawResponse Json? @map("raw_response")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  @@unique([companyId, idempotencyKey])
  @@map("meetings")
}

model OpportunityBrief {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id")
  leadId String? @map("lead_id") @db.Uuid
  conversationId String? @map("conversation_id") @db.Uuid
  need String?
  scope String?
  urgency String?
  budget String?
  authority String?
  objections String?
  nextStep String? @map("next_step")
  summary String
  status String @default("draft")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  @@map("opportunity_briefs")
}

model Followup {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id")
  leadId String? @map("lead_id") @db.Uuid
  conversationId String? @map("conversation_id") @db.Uuid
  channel String @default("whatsapp")
  recipient String
  message String
  templateName String? @map("template_name")
  scheduledAt DateTime @map("scheduled_at") @db.Timestamptz(6)
  sentAt DateTime? @map("sent_at") @db.Timestamptz(6)
  status String @default("scheduled")
  reason String?
  idempotencyKey String? @map("idempotency_key")
  opportunityFollowupDraftId String? @map("opportunity_followup_draft_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  @@unique([companyId, idempotencyKey])
  @@map("followups")
}

model OptOut {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id")
  channel String @default("whatsapp")
  recipient String
  optedOutAt DateTime @default(now()) @map("opted_out_at") @db.Timestamptz(6)
  reason String?
  @@unique([companyId, channel, recipient])
  @@map("opt_outs")
}

model AgentEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id")
  eventType String @map("event_type")
  aggregateType String? @map("aggregate_type")
  aggregateId String? @map("aggregate_id")
  payload Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("agent_events")
}

model AuditLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id")
  actorType String @default("system") @map("actor_type")
  actorId String? @map("actor_id")
  action String
  resourceType String? @map("resource_type")
  resourceId String? @map("resource_id")
  metadata Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("audit_logs")
}

model OutboundWebhookDelivery {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id")
  eventId String? @map("event_id") @db.Uuid
  targetUrl String @map("target_url")
  status String @default("pending")
  statusCode Int? @map("status_code")
  requestPayload Json @map("request_payload")
  responseBody Json? @map("response_body")
  errorMessage String? @map("error_message")
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("outbound_webhook_deliveries")
}

model AdminUser {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id")
  email String @unique
  passwordHash String @map("password_hash")
  role String @default("owner")
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  @@map("admin_users")
}

model AuthSession {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  refreshTokenHash String @unique @map("refresh_token_hash")
  csrfTokenHash String @map("csrf_token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("auth_sessions")
}

model GoogleOauthState {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stateHash String @unique @map("state_hash")
  companyId String @map("company_id")
  userId String @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  usedAt DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("google_oauth_states")
}

model JobQueue {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobType String @map("job_type")
  companyId String @map("company_id")
  dedupeKey String? @map("dedupe_key")
  payload Json @default("{}")
  runAt DateTime @default(now()) @map("run_at") @db.Timestamptz(6)
  status String @default("pending")
  attempts Int @default(0)
  errorMessage String? @map("error_message")
  lockedAt DateTime? @map("locked_at") @db.Timestamptz(6)
  lockExpiresAt DateTime? @map("lock_expires_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  @@unique([jobType, companyId, runAt])
  @@unique([jobType, companyId, dedupeKey])
  @@map("job_queue")
}

model Opportunity {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id")
  leadId String @map("lead_id") @db.Uuid
  conversationId String? @map("conversation_id") @db.Uuid
  assigneeId String? @map("assignee_id") @db.Uuid
  stage String @default("nuevo")
  score Int @default(0)
  scoreSignals Json @default("{}") @map("score_signals")
  serviceInterest String? @map("service_interest")
  estimatedValue Decimal? @map("estimated_value") @db.Decimal
  nextAction String? @map("next_action")
  lossReason String? @map("loss_reason")
  lastActivityAt DateTime @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  @@map("opportunities")
}

model OpportunityActivity {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id")
  opportunityId String @map("opportunity_id") @db.Uuid
  actorId String? @map("actor_id") @db.Uuid
  activityType String @map("activity_type")
  content String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("opportunity_activities")
}

model OpportunityProposal {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id")
  opportunityId String @map("opportunity_id") @db.Uuid
  status String @default("draft")
  title String
  content String
  createdBy String? @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  @@map("opportunity_proposals")
}

model OpportunityFollowupDraft {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id")
  opportunityId String @map("opportunity_id") @db.Uuid
  ruleKey String @map("rule_key")
  priority String @default("normal")
  message String
  templateName String? @map("template_name")
  status String @default("pending")
  rejectionReason String? @map("rejection_reason")
  reviewedBy String? @map("reviewed_by") @db.Uuid
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)
  followupId String? @map("followup_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  @@map("opportunity_followup_drafts")
}
