# App
NODE_ENV=production
PORT=3001
PUBLIC_WEBHOOK_BASE_URL=https://agent.saberoconsulting.com
APP_BASE_URL=https://agent.saberoconsulting.com
COMPANY_ID=sabero

# Supabase
DATABASE_URL=

# Meta WhatsApp Cloud API
META_GRAPH_API_VERSION=v25.0
META_APP_ID=1086951707051587
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WEBHOOK_SIGNATURE_REQUIRED=true

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=1200

# Google
GOOGLE_CALENDAR_ID=primary
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://agent.saberoconsulting.com/integrations/google/callback
OAUTH_TOKEN_ENCRYPTION_KEY=
GOOGLE_PICKER_API_KEY=
GOOGLE_APP_ID=829902045601
DRIVE_SYNC_ENABLED=true
DRIVE_SYNC_INTERVAL_MS=900000
DRIVE_SYNC_BATCH_SIZE=10

# RAG / embeddings
EMBEDDINGS_PROVIDER=local-hash
EMBEDDINGS_MODEL=local-hash-v1
EMBEDDINGS_DIMENSIONS=1536

# Commercial controls
DEFAULT_TIMEZONE=America/Lima
FOLLOWUP_ENABLED=true
MAX_FOLLOWUPS_PER_LEAD=3
HUMAN_ESCALATION_EMAIL=
HUMAN_ESCALATION_WHATSAPP=

# Security
AUTH_SECRET=
AUTH_TOKEN_TTL_SECONDS=43200
SERVICE_API_KEY=
OUTBOUND_WEBHOOK_SECRET=
OUTBOUND_WEBHOOK_URL=

# Bootstrap admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_COMPANY_ID=sabero
