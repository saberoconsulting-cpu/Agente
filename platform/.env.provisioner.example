# Administrative environment for the provisioning worker and admin CLI.
# Never mount this file into the HTTP `platform` service.
CONTROL_DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/sabero_control
PROVISION_DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/postgres
MONGODB_URI=mongodb://platform:CHANGE_ME@mongo:27017/?authSource=admin
PLATFORM_ENCRYPTION_KEY=
TENANT_POSTGRES_HOST=postgres
TENANT_POSTGRES_PORT=5432
TENANT_DOMAIN_SUFFIX=example.com
