PORT=3010
HOST=127.0.0.1
CONTROL_DATABASE_URL=postgresql://platform:CHANGE_ME@127.0.0.1:5432/sabero_control
# Administrative connection: used by admin CLI only, never passed to HTTP service.
PROVISION_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/postgres
# Host/port visible from the application containers.
TENANT_POSTGRES_HOST=postgres
TENANT_POSTGRES_PORT=5432
TENANT_DOMAIN_SUFFIX=example.com
MONGODB_URI=mongodb://platform:CHANGE_ME@127.0.0.1:27017/?authSource=admin
# 32 bytes encoded as hex. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLATFORM_ENCRYPTION_KEY=
TENANT_POOL_MAX=2
PLATFORM_ADMIN_COMPANY_ID=sabero
# Transactional application decisions. Store the real key only in the server environment.
ACCESS_NOTIFICATIONS_ENABLED=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=gerencia@saberoconsulting.com
BREVO_SENDER_NAME=SABERO Consulting
BREVO_REPLY_TO=gerencia@saberoconsulting.com
