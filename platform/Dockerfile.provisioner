# Provisioner image: only needs the agent backend's Prisma CLI for tenant migrations.
# Build context must be the repository root (parent of platform/ and backend/).
FROM node:22-bookworm-slim
# Prisma detects OpenSSL at install time; without it engines target openssl-1.1.x and crash on bookworm.
RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /repo/platform
COPY platform/package*.json ./
RUN npm ci --omit=dev
COPY platform/src ./src
WORKDIR /repo/backend
COPY backend/prisma ./prisma
RUN npm install --no-save prisma@6.19.0
WORKDIR /repo/platform
ENV HOST=0.0.0.0
CMD ["node", "src/provisioner.mjs"]
